{
  "opencollection": "1.0.0",
  "info": {
    "name": "GPTZero Batch Documents API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Analyze document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gptzero.me/v2/predict/files",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Analyze document"
        }
      ]
    }
  ],
  "bundled": true
}